# Copy to knock.local.env (not committed) and fill in. Paths are relative to this directory.
# File with the knock sequence as K1=... K2=... K3=... (kept with the router config, outside this repo):
PORTS_ENV=../path/to/knock-ports.env
# The home public IPv4 the page knocks. Baked into the page: run ./deploy.sh again when it changes.
KNOCK_IP=192.0.2.1
# Where the "continue" button goes when the link has no redirect= (kept out of the page source):
KNOCK_HOME=https://photos.example.com/
