# Copy to knock.local.env (not committed) and fill in. Paths are relative to this directory.
# File with the knock sequence as K1=... K2=... K3=... (kept with the router config, outside this repo):
PORTS_ENV=../path/to/knock-ports.env
# Name the page resolves over DoH to find the home public IP, and the IP to use if that fails:
KNOCK_HOST=home.example.com
KNOCK_IP=192.0.2.1
